# Postgres de Supabase (usar el driver asyncpg). Para pruebas locales: sqlite+aiosqlite:///./solora.db
DATABASE_URL=sqlite+aiosqlite:///./solora.db
# Supabase -> Project Settings -> API -> Project URL (las claves JWT se leen de su endpoint JWKS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=change-me
SUPABASE_STORAGE_BUCKET=cleaning-photos
CORS_ORIGINS=http://localhost:5173
ICAL_SYNC_MINUTES=30
ANTHROPIC_API_KEY=
